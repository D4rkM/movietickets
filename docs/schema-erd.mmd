erDiagram
    USERS ||--o{ BOOKINGS : places
    MOVIES ||--o{ SESSIONS : "shown in"
    CINEMAS ||--o{ ROOMS : has
    ROOMS ||--o{ SESSIONS : hosts
    ROOMS ||--o{ SEATS : contains
    SESSIONS ||--o{ BOOKINGS : "booked for"
    SESSIONS ||--o{ BOOKING_SEATS : "scopes uniqueness"
    BOOKINGS ||--o{ BOOKING_SEATS : includes
    SEATS ||--o{ BOOKING_SEATS : "reserved as"
    BOOKINGS ||--o{ PAYMENTS : "payment attempts"
    BOOKINGS ||--o{ PAYMENT_EVENTS : "audited by"
    PAYMENTS |o--o{ PAYMENT_EVENTS : "logs"

    USERS {
        uuid id PK
        text name
        text email UK
        text password_hash
        text role
    }
    MOVIES {
        uuid id PK
        text title
        text synopsis
        int duration_minutes
        text poster_url
        text rating
    }
    CINEMAS {
        uuid id PK
        text name
        text address
        text city
    }
    ROOMS {
        uuid id PK
        uuid cinema_id FK
        text name
        int rows
        int seats_per_row
    }
    SEATS {
        uuid id PK
        uuid room_id FK
        text row_label
        int seat_number
    }
    SESSIONS {
        uuid id PK
        uuid movie_id FK
        uuid room_id FK
        timestamptz starts_at
        int price_cents
    }
    BOOKINGS {
        uuid id PK
        uuid user_id FK
        uuid session_id FK
        text status
        timestamptz expires_at
        boolean needs_refund_review
        timestamptz stale_payment_alerted_at
    }
    BOOKING_SEATS {
        uuid id PK
        uuid booking_id FK
        uuid session_id FK
        uuid seat_id FK
        text ticket_type
        text half_price_document
        int price_cents
    }
    PAYMENTS {
        uuid id PK "attemptId"
        uuid booking_id FK
        text provider
        text external_payment_id UK "partial: not null"
        text status
        text status_detail
        int amount_cents
        int installments
        text payment_method_id
        timestamptz updated_at
    }
    PAYMENT_EVENTS {
        uuid id PK
        uuid booking_id FK
        uuid payment_id FK "nullable"
        text type
        jsonb payload
        timestamptz created_at
    }
