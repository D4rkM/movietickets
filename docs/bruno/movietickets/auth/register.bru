meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Ana",
    "email": "ana@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}

docs {
  Cria um usuário novo e já salva o accessToken retornado na env var
  `accessToken`, usada nas rotas protegidas por JWT (ex: seating).

  Se o e-mail já existir, retorna 409 — nesse caso use o Login em vez
  do Register.
}
