DATABASE_URL=postgres://movietickets:movietickets@localhost:5432/movietickets
VALKEY_URL=redis://localhost:6379
JWT_SECRET=changeme-in-production
JWT_EXPIRES_IN=1h
PORT=3000
LOG_LEVEL=info
# Running through ngrok (see README's "Rodando com ngrok" section): set
# PUBLIC_API_URL to the `api` tunnel URL (Mercado Pago webhook base) and add
# the `web` tunnel URL to CORS_ORIGIN, comma-separated, alongside localhost:
# CORS_ORIGIN=http://localhost:5173,<web-tunnel-url>
# PUBLIC_API_URL=<api-tunnel-url>
CORS_ORIGIN=http://localhost:5173
# Mercado Pago test Access Token (starts with TEST-), from the application's
# "Credenciais de teste" page. The web's VITE_MP_PUBLIC_KEY must come from the
# same application. Seller test-user (APP_USR-) or production credentials make
# payments fail with 422 PAYMENT_REQUEST_INVALID.
MERCADOPAGO_ACCESS_TOKEN=
PUBLIC_API_URL=http://localhost:3000
# Unused: left over from the removed Checkout Pro redirect, no code reads it.
WEB_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=MovieTickets <no-reply@movietickets.local>
