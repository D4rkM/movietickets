DATABASE_URL=postgres://movietickets:movietickets@localhost:5432/movietickets
VALKEY_URL=redis://localhost:6379
JWT_SECRET=changeme-in-production
JWT_EXPIRES_IN=1h
PORT=3000
LOG_LEVEL=info
# Testing the Mercado Pago checkout/webhook locally needs public https URLs
# instead of localhost (see README's ngrok section) — set these three to your
# `make expose` tunnel URLs for that, comma-separating the web one into
# CORS_ORIGIN alongside localhost:
# CORS_ORIGIN=http://localhost:5173,<web-tunnel-url>
# WEB_URL=<web-tunnel-url>
# PUBLIC_API_URL=<api-tunnel-url>
CORS_ORIGIN=http://localhost:5173
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=MovieTickets <no-reply@movietickets.local>
