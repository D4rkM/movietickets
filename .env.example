# Build args for the `web` image in `make up-full` / `docker compose --profile full`.
# docker compose reads this root .env automatically and passes these as build
# args (apps/web/.env is excluded from the image by .dockerignore). Rebuild after
# changing: docker compose --profile full up -d --build web
VITE_API_URL=http://localhost:3000
# Mercado Pago test Public Key (TEST-...), same application as the API's
# MERCADOPAGO_ACCESS_TOKEN.
VITE_MP_PUBLIC_KEY=TEST-your-public-key
